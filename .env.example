# Shopify Storefront API
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=your-storefront-access-token

# Shopify Admin API (required for subscription management & webhooks)
SHOPIFY_ADMIN_ACCESS_TOKEN=your-admin-access-token
SHOPIFY_WEBHOOK_SECRET=your-webhook-secret

# Shopify Customer Account API
SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_ID=your-client-id
SHOPIFY_SHOP_ID=your-shop-id

# Session encryption
SESSION_SECRET=your-session-secret-min-32-chars

# Sanity
NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_READ_TOKEN=your-read-token

# Google Tag Manager (GA4 is configured inside the GTM container)
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# Firebase (client-side)
NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id

# Firebase Admin (server-side)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY=base64-encoded-private-key

# Sentry (optional — error tracking won't load without this)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# LINE Login (direct OAuth via /api/line-login + /api/line-callback)
AUTH_LINE_ID=your-line-channel-id
AUTH_LINE_SECRET=your-line-channel-secret

# LIFF account linking (案A: LINE×Shopify 連携)
# NEXT_PUBLIC_LIFF_ID: LIFF アプリ ID（公開値。ブラウザで liff.init に使う。例 1234567890-AbCdEfGh）
# LINE_LIFF_CHANNEL_ID: LIFF が属する LINE Login チャネルの Channel ID（サーバで id_token を
#   LINE verify API に通すときの client_id。id_token の aud と一致する必要がある）。
# 前提: この LINE Login チャネルと Bot の Messaging API チャネルは「同一プロバイダー」に置くこと
#   （同一プロバイダーなら id_token の sub == Messaging userId になり、Bot/customer_linkages と揃う）。
NEXT_PUBLIC_LIFF_ID=your-liff-id
LINE_LIFF_CHANNEL_ID=your-line-login-channel-id
# LINE_LIFF_CHANNEL_SECRET: 上と同じ LINE Login チャネルの Channel Secret。
# Web マイページ発の連携 (P2 / /api/user/line-link/*) が認可コードをトークンに交換するのに使う。
# LIFF 経路 (id_token をブラウザから受け取る) では不要だったが、Web 発フローは
# サーバが自分で code→token 交換をするため必須。未設定なら連携導線は 503 で自動的に畳まれる。
# 未設定時は LINE_LOGIN_CHANNEL_SECRET にフォールバックする (LINE_LIFF_CHANNEL_ID と
# LINE_LOGIN_CHANNEL_ID は同一 Login チャネル 2009473839 を指すため両 secret は同値)。
# 本番 Vercel は LINE_LOGIN_CHANNEL_SECRET が設定済みなので、この値の新規追加は不要。
LINE_LIFF_CHANNEL_SECRET=your-line-login-channel-secret

# Shared secret for cx-agent identity linking API (X-API-Key header)
SYNC_API_SECRET=your-sync-api-secret

# Page Registry & Content Sync (Notion → Sanity)
NOTION_PAGE_REGISTRY_DB_ID=
NOTION_PAGE_CONTENT_DB_ID=

# Notion → Sanity 記事同期 (scripts/sync-notion-to-sanity.ts)
# ローカルは .env / サーバーは GitHub Secrets。どちらも同じ名前で process.env に入る。
NOTION_API_KEY=
NOTION_CONTENT_HUB_DB_ID=
# Sanity への書き込み用トークン (旧: ~/.config/sanity/config.json の直読み)
SANITY_API_WRITE_TOKEN=
# 同期失敗時の通知先 (未設定なら Job Summary と結果ファイルのみに残る)
SLACK_WEBHOOK_URL=
