{
  "name": "elxea-developer",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node ./scripts/copy-maplibre-worker.mjs && next dev",
    "emulator:start": "npx --yes firebase-tools@14 emulators:start --only firestore --project demo-elxea",
    "dev:emulator": "FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 NEXT_PUBLIC_FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 pnpm dev",
    "test:e2e:emulator": "FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 NEXT_PUBLIC_FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 pnpm test:e2e",
    "build": "node ./scripts/copy-maplibre-worker.mjs && node sd.config.mjs && npx tsx scripts/check-placeholders.ts && next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "lint:prune-suppressions": "eslint . --prune-suppressions",
    "check:sot": "node scripts/ops/check-sot-registry.mjs --check",
    "check:ratchet": "node scripts/ops/check-ratchet.mjs --check",
    "update:ratchet": "node scripts/ops/check-ratchet.mjs --update",
    "generate:sot": "node scripts/ops/check-sot-registry.mjs",
    "typecheck:clean": "node -e \"const fs=require('node:fs');for(const p of ['.next/types','.next/dev/types'])fs.rmSync(p,{recursive:true,force:true});fs.rmSync('tsconfig.tsbuildinfo',{force:true})\"",
    "typecheck": "pnpm typecheck:clean && next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "VITEST_COVERAGE=1 vitest run --project unit",
    "test:e2e": "playwright test",
    "report:e2e-skips": "node scripts/ci/e2e-skip-summary.mjs",
    "build:tokens": "node sd.config.mjs",
    "validate:tokens": "npx tsx scripts/design-system/validate-tokens.ts",
    "validate:design-map": "npx tsx scripts/design-system/validate-design-map.ts",
    "validate:placeholders": "npx tsx scripts/check-placeholders.ts",
    "generate:design-kit": "npx tsx scripts/design-system/generate-design-kit.ts",
    "validate:design-kit": "npx tsx scripts/design-system/validate-design-kit.ts",
    "deploy:indexes": "tsx scripts/deploy-firestore-indexes.ts",
    "deploy:indexes:dry": "tsx scripts/deploy-firestore-indexes.ts --dry-run",
    "migrate:follows:dry": "tsx scripts/migrate-follows-to-favorites.ts --dry-run",
    "migrate:follows": "tsx scripts/migrate-follows-to-favorites.ts --apply",
    "sync:notion": "tsx scripts/sync-notion-to-sanity.ts",
    "sync:notion:dry": "tsx scripts/sync-notion-to-sanity.ts --dry-run",
    "design-catalog": "storybook dev -p 6006",
    "build:design-catalog": "storybook build",
    "build-storybook": "storybook build",
    "shots:design-catalog": "node scripts/storybook-story-shots.mjs --headed --out .storybook-shots",
    "chromatic": "chromatic --exit-zero-on-changes",
    "sync:figma-read": "npx tsx scripts/design-system/sync-figma-read.ts",
    "snapshot:figma": "npx tsx scripts/design-system/figma-snapshot.ts",
    "diff:figma": "npx tsx scripts/design-system/figma-change-manifest.ts",
    "audit:ds-instance-rate": "npx tsx scripts/design-system/figma-ds-instance-rate.ts",
    "audit:components": "npx tsx scripts/design-system/audit-components.ts",
    "diff:tokens": "npx tsx scripts/design-system/diff-tokens.ts"
  },
  "dependencies": {
    "@ai-sdk/react": "^3.0.136",
    "@base-ui/react": "^1.3.0",
    "@hookform/resolvers": "^5.2.2",
    "@line/liff": "^2.29.1",
    "@portabletext/react": "^6.0.3",
    "@portabletext/types": "^4.0.2",
    "@sanity/image-url": "^1.2.0",
    "@sanity/vision": "^5.18.0",
    "@sentry/nextjs": "^10.46.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.37.0",
    "ai": "^6.0.134",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "d3-contour": "^4.0.2",
    "date-fns": "^4.1.0",
    "embla-carousel-react": "^8.6.0",
    "firebase": "^12.10.0",
    "firebase-admin": "^13.7.0",
    "input-otp": "^1.4.2",
    "lenis": "^1.3.19",
    "lucide-react": "^0.577.0",
    "maplibre-gl": "^6.4.0",
    "motion": "^12.38.0",
    "next": "^16.2.1",
    "next-intl": "^4.8.3",
    "next-sanity": "^12.2.1",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "^19.2.4",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.71.2",
    "react-resizable-panels": "^4.7.3",
    "recharts": "2.15.4",
    "resend": "^6.9.4",
    "sanity": "^5.18.0",
    "sonner": "^2.0.7",
    "styled-components": "^6.3.11",
    "tailwind-merge": "^3.5.0",
    "vaul": "^1.1.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.0.1",
    "@notionhq/client": "^2.3.0",
    "@playwright/test": "^1.58.2",
    "@storybook/addon-a11y": "^10.2.19",
    "@storybook/addon-docs": "^10.2.19",
    "@storybook/addon-onboarding": "^10.2.19",
    "@storybook/addon-vitest": "^10.2.19",
    "@storybook/nextjs-vite": "^10.2.19",
    "@tailwindcss/postcss": "^4.2.1",
    "@tailwindcss/vite": "^4.2.2",
    "@tokens-studio/sd-transforms": "^2.0.3",
    "@types/d3-contour": "^3.0.6",
    "@types/node": "^25.3.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitest/browser-playwright": "^4.1.0",
    "@vitest/coverage-v8": "^4.1.0",
    "chromatic": "^15.3.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.1",
    "eslint-plugin-storybook": "^10.2.19",
    "playwright": "^1.58.2",
    "postcss": "^8.5.8",
    "storybook": "^10.2.19",
    "style-dictionary": "^5.3.3",
    "tailwindcss": "^4.2.1",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.0",
    "vitest": "^4.1.1"
  },
  "packageManager": "pnpm@10.30.0"
}
