rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // -----------------------------------------------------------------------
    // Helper functions
    // -----------------------------------------------------------------------

    // Check if the request comes from Firebase Admin SDK (server-side).
    // Admin SDK bypasses all rules, so this is mainly documentation.
    // Client requests are the ones governed by these rules.

    // Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if the authenticated user owns this customer document.
    // We store the Shopify numeric customer ID as custom claim "shopifyCustomerId"
    // in the Firebase Auth token (set by server when linking accounts).
    function isOwner(customerId) {
      return isAuthenticated()
        && request.auth.token.shopifyCustomerId == customerId;
    }

    // -----------------------------------------------------------------------
    // users/{customerId} — customer master document
    // -----------------------------------------------------------------------
    match /users/{customerId} {
      // Authenticated users can read their own profile
      allow read: if isOwner(customerId);

      // Only server (Admin SDK) can write user profile fields like
      // persona, tasteProfile, depthLevel, membershipTier.
      // Client cannot create or update user documents directly.
      allow write: if false;

      // --- Subcollections ---

      // favorites — users can read/write their own favorites
      match /favorites/{docId} {
        allow read: if isOwner(customerId);
        allow create: if isOwner(customerId)
          && request.resource.data.keys().hasAll(['type', 'targetId', 'title'])
          && request.resource.data.type in ['product', 'article'];
        allow delete: if isOwner(customerId);
        allow update: if false;
      }

      // follows — users can read/write their own farmer follows
      match /follows/{docId} {
        allow read: if isOwner(customerId);
        allow create: if isOwner(customerId)
          && request.resource.data.keys().hasAll(['farmerSlug', 'farmerName']);
        allow delete: if isOwner(customerId);
        allow update: if false;
      }

      // eventRegistrations — users can read/write their own registrations
      match /eventRegistrations/{docId} {
        allow read: if isOwner(customerId);
        allow create: if isOwner(customerId)
          && request.resource.data.keys().hasAll(['eventSlug', 'eventTitle']);
        allow delete: if isOwner(customerId);
        allow update: if false;
      }

      // behaviorLog — server-only write, user can read their own
      match /behaviorLog/{docId} {
        allow read: if isOwner(customerId);
        allow write: if false;
      }

      // conversations — server-only write, user can read their own
      match /conversations/{docId} {
        allow read: if isOwner(customerId);
        allow write: if false;
      }

      // orders — server-only write (mirrored from Shopify webhooks), user can read
      match /orders/{orderId} {
        allow read: if isOwner(customerId);
        allow write: if false;
      }
    }

    // -----------------------------------------------------------------------
    // comments — top-level collection
    // -----------------------------------------------------------------------
    match /comments/{commentId} {
      // Anyone authenticated can read approved comments
      allow read: if isAuthenticated()
        && resource.data.status == 'approved';

      // Authenticated users can create comments
      allow create: if isAuthenticated()
        && request.resource.data.keys().hasAll(['targetType', 'targetId', 'authorId', 'authorName', 'body', 'status'])
        && request.resource.data.targetType in ['article', 'farmer']
        && request.resource.data.body.size() <= 500
        && request.resource.data.body.size() > 0
        && request.resource.data.status == 'approved'
        && request.resource.data.authorId == request.auth.token.shopifyCustomerId;

      // Only the author can delete their own comment
      allow delete: if isAuthenticated()
        && resource.data.authorId == request.auth.token.shopifyCustomerId;

      // No client-side updates
      allow update: if false;
    }

    // -----------------------------------------------------------------------
    // Deny all other paths
    // -----------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
