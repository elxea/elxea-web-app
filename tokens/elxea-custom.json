{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "elxea custom tokens — ShadCN base override layer. Brand voice: Space (余白) / Fractal (相似) / Timeless (普遍) / Playfulness (あそびごころ) / Neo Classic (新しいけれど、どこか懐かしい). Colors are OKLCH only. Override targets ShadCN/ui default CSS variable names (--background, --foreground, --primary, etc.) plus 7 categories (color, typography, spacing, radius, shadow, z-index, breakpoint). Pair with tokens/base.json; this file holds only deltas.",
  "$meta": {
    "name": "elxea-custom",
    "version": "0.2.0-dogfood-phase-B",
    "phase": "DS-1",
    "base-layer": "shadcn/ui defaults (oklch / new-york style)",
    "sibling-file": "tokens/base.json",
    "spec": "https://www.notion.so/36970c9d064c813fb7abdc9e3403c14c",
    "brand-source": "https://www.notion.so/circl/Visual-Identity-f87f290633774500bc2294a94ed66296"
  },

  "color": {
    "$description": "Override ShadCN base CSS variable names with elxea brand palette. All OKLCH. Light + Dark mode pairs.",
    "$type": "color",

    "light": {
      "background":            { "$value": "oklch(0.933 0.012 96.4)", "$description": "ShadCN --background. elxea cream (#ebe9e0). Space — undertone of paper, not white-out." },
      "foreground":            { "$value": "oklch(0.397 0.002 247.9)", "$description": "ShadCN --foreground. elxea graphite (#464748). Body text contrast 6.18:1 vs background — passes AA Large + AA Normal." },
      "card":                  { "$value": "oklch(0.963 0.008 96.4)", "$description": "ShadCN --card. Slightly lighter than background for raised surfaces. Cream +0.030 L." },
      "card-foreground":       { "$value": "oklch(0.397 0.002 247.9)", "$description": "ShadCN --card-foreground. Same as foreground." },
      "popover":               { "$value": "oklch(0.978 0.005 96.4)", "$description": "ShadCN --popover. Highest light surface, near-white but warm." },
      "popover-foreground":    { "$value": "oklch(0.397 0.002 247.9)" },
      "primary":               { "$value": "oklch(0.397 0.002 247.9)", "$description": "ShadCN --primary. elxea graphite. Quiet authority — not gold (gold is accent only)." },
      "primary-foreground":    { "$value": "oklch(0.978 0.005 96.4)", "$description": "ShadCN --primary-foreground. Cream on graphite. Contrast 9.21:1 vs primary — AAA." },
      "secondary":             { "$value": "oklch(0.863 0.026 102.0)", "$description": "ShadCN --secondary. elxea sand (#d5d3c0). Quiet alternate." },
      "secondary-foreground":  { "$value": "oklch(0.397 0.002 247.9)" },
      "muted":                 { "$value": "oklch(0.893 0.018 99.0)", "$description": "ShadCN --muted. Between cream and sand for hover/disabled surfaces." },
      "muted-foreground":      { "$value": "oklch(0.450 0.005 271.3)", "$description": "ShadCN --muted-foreground. Hotfix from P-2.5 (oklch 0.615 → 0.450) for AA contrast 4.52:1 vs background." },
      "accent":                { "$value": "oklch(0.846 0.173 85.6)", "$description": "ShadCN --accent. elxea gold (#ffc200). Use sparingly — Playfulness, not loudness." },
      "accent-foreground":     { "$value": "oklch(0.397 0.002 247.9)", "$description": "Graphite on gold. Contrast 5.42:1 — AA Normal." },
      "destructive":           { "$value": "oklch(0.572 0.133 16.4)", "$description": "ShadCN --destructive. elxea tea-red (#b9525c). Tone-coordinated, not pure red." },
      "destructive-foreground":{ "$value": "oklch(1 0 0)" },
      "border":                { "$value": "oklch(0.742 0.017 102.9)", "$description": "ShadCN --border. elxea stone (#adaca0). Subtle, not stark — Space principle." },
      "input":                 { "$value": "oklch(0.742 0.017 102.9)" },
      "ring":                  { "$value": "oklch(0.846 0.173 85.6)", "$description": "ShadCN --ring. Gold focus ring — visible without being aggressive." },
      "chart-1":               { "$value": "oklch(0.846 0.173 85.6)", "$description": "Gold" },
      "chart-2":               { "$value": "oklch(0.807 0.050 178.3)", "$description": "Tea green" },
      "chart-3":               { "$value": "oklch(0.572 0.133 16.4)", "$description": "Tea red" },
      "chart-4":               { "$value": "oklch(0.821 0.061 41.5)", "$description": "Tea warm peach" },
      "chart-5":               { "$value": "oklch(0.482 0.005 271.3)", "$description": "Charcoal" },

      "success":               { "$value": "oklch(0.807 0.050 178.3)" },
      "success-foreground":    { "$value": "oklch(0.397 0.002 247.9)" },
      "warning":               { "$value": "oklch(0.846 0.173 85.6)" },
      "warning-foreground":    { "$value": "oklch(0.397 0.002 247.9)" },
      "info":                  { "$value": "oklch(0.623 0.214 259.815)" },
      "info-foreground":       { "$value": "oklch(1 0 0)" }
    },

    "dark": {
      "background":            { "$value": "oklch(0.220 0.005 271.3)", "$description": "ShadCN --background. Dark graphite-charcoal hybrid. Timeless — calm, not pitch black." },
      "foreground":            { "$value": "oklch(0.933 0.012 96.4)", "$description": "ShadCN --foreground. elxea cream on dark. Contrast 11.04:1 — AAA." },
      "card":                  { "$value": "oklch(0.260 0.005 271.3)", "$description": "Slightly lighter raised surface in dark mode." },
      "card-foreground":       { "$value": "oklch(0.933 0.012 96.4)" },
      "popover":               { "$value": "oklch(0.290 0.005 271.3)" },
      "popover-foreground":    { "$value": "oklch(0.933 0.012 96.4)" },
      "primary":               { "$value": "oklch(0.933 0.012 96.4)", "$description": "Cream as primary in dark — inverse of light mode." },
      "primary-foreground":    { "$value": "oklch(0.220 0.005 271.3)" },
      "secondary":             { "$value": "oklch(0.320 0.005 271.3)" },
      "secondary-foreground":  { "$value": "oklch(0.933 0.012 96.4)" },
      "muted":                 { "$value": "oklch(0.320 0.005 271.3)" },
      "muted-foreground":      { "$value": "oklch(0.742 0.017 102.9)", "$description": "elxea stone. Contrast 5.21:1 vs dark background — AA Normal." },
      "accent":                { "$value": "oklch(0.846 0.173 85.6)", "$description": "Gold accent — same hue, brighter visual presence on dark." },
      "accent-foreground":     { "$value": "oklch(0.220 0.005 271.3)" },
      "destructive":           { "$value": "oklch(0.640 0.150 16.4)", "$description": "Lightened tea-red for dark contrast." },
      "destructive-foreground":{ "$value": "oklch(0.220 0.005 271.3)" },
      "border":                { "$value": "oklch(0.397 0.002 247.9)", "$description": "Graphite border on dark — subtle but visible." },
      "input":                 { "$value": "oklch(0.397 0.002 247.9)" },
      "ring":                  { "$value": "oklch(0.846 0.173 85.6)" },
      "chart-1":               { "$value": "oklch(0.846 0.173 85.6)" },
      "chart-2":               { "$value": "oklch(0.807 0.050 178.3)" },
      "chart-3":               { "$value": "oklch(0.640 0.150 16.4)" },
      "chart-4":               { "$value": "oklch(0.821 0.061 41.5)" },
      "chart-5":               { "$value": "oklch(0.933 0.012 96.4)" },

      "success":               { "$value": "oklch(0.807 0.050 178.3)" },
      "success-foreground":    { "$value": "oklch(0.220 0.005 271.3)" },
      "warning":               { "$value": "oklch(0.846 0.173 85.6)" },
      "warning-foreground":    { "$value": "oklch(0.220 0.005 271.3)" },
      "info":                  { "$value": "oklch(0.700 0.180 259.815)" },
      "info-foreground":       { "$value": "oklch(0.220 0.005 271.3)" }
    },

    "brand": {
      "$description": "Brand palette (mode-independent reference). Use only via semantic tokens above; do not bind directly.",
      "cream":      { "$value": "oklch(0.933 0.012 96.4)", "$description": "#ebe9e0 gray-20" },
      "sand":       { "$value": "oklch(0.863 0.026 102.0)", "$description": "#d5d3c0 gray-40" },
      "stone":      { "$value": "oklch(0.742 0.017 102.9)", "$description": "#adaca0 gray-60" },
      "ash":        { "$value": "oklch(0.615 0.006 106.6)", "$description": "#858581 gray-80" },
      "charcoal":   { "$value": "oklch(0.482 0.005 271.3)", "$description": "#5d5e61 gray-100" },
      "graphite":   { "$value": "oklch(0.397 0.002 247.9)", "$description": "#464748 gray-120" },
      "gold":       { "$value": "oklch(0.846 0.173 85.6)", "$description": "#ffc200 secondary" },
      "tea-green":  { "$value": "oklch(0.807 0.050 178.3)", "$description": "#9ecbc0" },
      "tea-red":    { "$value": "oklch(0.572 0.133 16.4)", "$description": "#b9525c" },
      "tea-warm":   { "$value": "oklch(0.821 0.061 41.5)", "$description": "#e8b8a6" }
    }
  },

  "typography": {
    "$description": "Override ShadCN typography defaults. Brand voice: 控えめで繊細, 余白を活かす. Display + headings use light weights to convey Space / Timeless. Body uses normal weight with wider line-height (1.75) and letter-spacing (0.05em) for Japanese text density.",

    "family": {
      "$type": "fontFamily",
      "sans":      { "$value": "aktiv-grotesk, dnp-shuei-gothic-gin-std, sans-serif", "$description": "Body (EN: aktiv-grotesk, JP: dnp-shuei-gothic-gin-std / 秀英角ゴシック銀)" },
      "heading":   { "$value": "aktiv-grotesk-extended, dnp-shuei-gothic-gin-std, sans-serif", "$description": "Headings (EN: aktiv-grotesk-extended, JP: dnp-shuei-gothic-gin)" },
      "special":   { "$value": "dnp-shuei-ymincho-std, Georgia, serif", "$description": "JP mincho for editorial / Neo Classic moments" },
      "mono":      { "$value": "SF Mono, Menlo, monospace" }
    },

    "size": {
      "$type": "dimension",
      "$description": "Modular scale base=1rem, ratio 1.25 (major third). Range 0.625rem (2xs) → 8rem (9xl).",
      "2xs":  { "$value": "0.625rem" },
      "xs":   { "$value": "0.75rem" },
      "sm":   { "$value": "0.875rem" },
      "base": { "$value": "1rem" },
      "lg":   { "$value": "1.125rem" },
      "xl":   { "$value": "1.25rem" },
      "2xl":  { "$value": "1.5rem" },
      "3xl":  { "$value": "1.875rem" },
      "4xl":  { "$value": "2.25rem" },
      "5xl":  { "$value": "3rem" },
      "6xl":  { "$value": "3.75rem" },
      "7xl":  { "$value": "4.5rem" },
      "8xl":  { "$value": "6rem" },
      "9xl":  { "$value": "8rem" }
    },

    "weight": {
      "$type": "fontWeight",
      "$description": "Restricted active set: light (300) for display/h1, normal (400) for h2-h3/body, medium (500) for h4-h6/UI labels, semibold (600) for overline only. Bold (700) reserved for emphasis only — do not use as default heading weight.",
      "light":    { "$value": "300", "$description": "Display, h1 — Space / 繊細" },
      "normal":   { "$value": "400", "$description": "h2-h3, body" },
      "medium":   { "$value": "500", "$description": "h4-h6, button label, UI label" },
      "semibold": { "$value": "600", "$description": "Overline / caps label only" },
      "bold":     { "$value": "700", "$description": "Emphasis only — not for headings" }
    },

    "line-height": {
      "$type": "number",
      "tight":   { "$value": "1.2",  "$description": "Display only" },
      "snug":    { "$value": "1.3",  "$description": "Headings h1-h3" },
      "normal":  { "$value": "1.5",  "$description": "Headings h4-h6, captions" },
      "relaxed": { "$value": "1.625" },
      "loose":   { "$value": "1.75", "$description": "Body — JP density, Space breathing" }
    },

    "letter-spacing": {
      "$type": "dimension",
      "tight":  { "$value": "-0.01em", "$description": "Display only" },
      "normal": { "$value": "0em",     "$description": "Headings h1-h2" },
      "narrow": { "$value": "0.01em",  "$description": "h3" },
      "wide":   { "$value": "0.02em",  "$description": "h4-h6, UI labels" },
      "body":   { "$value": "0.05em",  "$description": "Body — Webflow standard for JP readability" },
      "caps":   { "$value": "0.125em", "$description": "Overline / uppercase label" }
    },

    "style": {
      "$type": "typography",
      "$description": "Composite presets. Source: Webflow inheritance + brand voice adjustments (light weights for display/h1).",
      "display":  { "$value": { "fontFamily": "{typography.family.heading.$value}", "fontSize": "2.75rem",   "fontWeight": "300", "line-height": "1.2",  "letter-spacing": "-0.01em" }, "$description": "Hero — 繊細, understated" },
      "h1":       { "$value": { "fontFamily": "{typography.family.heading.$value}", "fontSize": "2rem",      "fontWeight": "300", "line-height": "1.3",  "letter-spacing": "0em" } },
      "h2":       { "$value": { "fontFamily": "{typography.family.heading.$value}", "fontSize": "1.5rem",    "fontWeight": "400", "line-height": "1.3",  "letter-spacing": "0em" } },
      "h3":       { "$value": { "fontFamily": "{typography.family.heading.$value}", "fontSize": "1.25rem",   "fontWeight": "400", "line-height": "1.35", "letter-spacing": "0.01em" } },
      "h4":       { "$value": { "fontFamily": "{typography.family.heading.$value}", "fontSize": "1rem",      "fontWeight": "500", "line-height": "1.5",  "letter-spacing": "0.02em" } },
      "h5":       { "$value": { "fontFamily": "{typography.family.heading.$value}", "fontSize": "0.875rem",  "fontWeight": "500", "line-height": "1.5",  "letter-spacing": "0.02em" } },
      "h6":       { "$value": { "fontFamily": "{typography.family.heading.$value}", "fontSize": "0.8125rem", "fontWeight": "500", "line-height": "1.5",  "letter-spacing": "0.02em" } },
      "body-lg":  { "$value": { "fontFamily": "{typography.family.sans.$value}",    "fontSize": "1.125rem",  "fontWeight": "400", "line-height": "1.75", "letter-spacing": "0.05em" } },
      "body":     { "$value": { "fontFamily": "{typography.family.sans.$value}",    "fontSize": "1rem",      "fontWeight": "400", "line-height": "1.75", "letter-spacing": "0.05em" } },
      "body-sm":  { "$value": { "fontFamily": "{typography.family.sans.$value}",    "fontSize": "0.875rem",  "fontWeight": "400", "line-height": "1.5",  "letter-spacing": "0.05em" } },
      "caption":  { "$value": { "fontFamily": "{typography.family.sans.$value}",    "fontSize": "0.75rem",   "fontWeight": "400", "line-height": "1.5",  "letter-spacing": "0.05em" } },
      "overline": { "$value": { "fontFamily": "{typography.family.heading.$value}", "fontSize": "0.75rem",   "fontWeight": "600", "line-height": "1.5",  "letter-spacing": "0.125em" }, "$description": "Uppercase label" },
      "code":     { "$value": { "fontFamily": "{typography.family.mono.$value}",    "fontSize": "0.875rem",  "fontWeight": "400", "line-height": "1.5",  "letter-spacing": "0em" } }
    }
  },

  "spacing": {
    "$type": "dimension",
    "$description": "8pt grid (0.25rem step). Range 0 → 24rem (96). Inherits ShadCN scale. Fractal principle: same scale applies at component / layout / page level.",
    "0":   { "$value": "0px" },
    "px":  { "$value": "1px" },
    "0.5": { "$value": "0.125rem" },
    "1":   { "$value": "0.25rem" },
    "1.5": { "$value": "0.375rem" },
    "2":   { "$value": "0.5rem" },
    "2.5": { "$value": "0.625rem" },
    "3":   { "$value": "0.75rem" },
    "3.5": { "$value": "0.875rem" },
    "4":   { "$value": "1rem" },
    "5":   { "$value": "1.25rem" },
    "6":   { "$value": "1.5rem" },
    "7":   { "$value": "1.75rem" },
    "8":   { "$value": "2rem" },
    "9":   { "$value": "2.25rem" },
    "10":  { "$value": "2.5rem" },
    "11":  { "$value": "2.75rem" },
    "12":  { "$value": "3rem" },
    "14":  { "$value": "3.5rem" },
    "16":  { "$value": "4rem" },
    "20":  { "$value": "5rem" },
    "24":  { "$value": "6rem" },
    "28":  { "$value": "7rem" },
    "32":  { "$value": "8rem" },
    "40":  { "$value": "10rem" },
    "48":  { "$value": "12rem" },
    "56":  { "$value": "14rem" },
    "64":  { "$value": "16rem" },
    "80":  { "$value": "20rem" },
    "96":  { "$value": "24rem" }
  },

  "radius": {
    "$type": "dimension",
    "$description": "ShadCN --radius override. elxea uses moderate rounding: not sharp (硬い) / not pillowy (子供っぽい). default = 0.5rem (8px) — same as ShadCN; explicit so override is intentional.",
    "none": { "$value": "0px" },
    "sm":   { "$value": "0.25rem",  "$description": "ShadCN --radius-sm. Tight elements (badge, tag)" },
    "md":   { "$value": "0.375rem", "$description": "ShadCN --radius-md. Default form controls" },
    "lg":   { "$value": "0.5rem",   "$description": "ShadCN --radius. Card, dialog default" },
    "xl":   { "$value": "0.75rem",  "$description": "ShadCN --radius-xl. Hero, large surfaces" },
    "2xl":  { "$value": "1rem" },
    "3xl":  { "$value": "1.5rem" },
    "full": { "$value": "9999px",   "$description": "Pill, avatar" }
  },

  "shadow": {
    "$type": "shadow",
    "$description": "ShadCN shadow override. elxea uses very low opacity (0.06-0.10) for Space (余白) — shadows whisper, not declare. No colored shadows.",
    "xs": { "$value": { "offsetX": "0px", "offsetY": "1px", "blur": "2px", "spread": "0px", "color": "rgb(0 0 0 / 0.05)" }, "$description": "Subtle lift (input focus)" },
    "sm": { "$value": { "offsetX": "0px", "offsetY": "1px", "blur": "3px", "spread": "0px", "color": "rgb(0 0 0 / 0.06)" }, "$description": "ShadCN --shadow-sm. Button hover" },
    "md": { "$value": [
              { "offsetX": "0px", "offsetY": "4px", "blur": "6px",  "spread": "-1px", "color": "rgb(0 0 0 / 0.08)" },
              { "offsetX": "0px", "offsetY": "2px", "blur": "4px",  "spread": "-2px", "color": "rgb(0 0 0 / 0.06)" }
            ], "$description": "Card raised" },
    "lg": { "$value": [
              { "offsetX": "0px", "offsetY": "10px","blur": "15px", "spread": "-3px", "color": "rgb(0 0 0 / 0.08)" },
              { "offsetX": "0px", "offsetY": "4px", "blur": "6px",  "spread": "-4px", "color": "rgb(0 0 0 / 0.06)" }
            ], "$description": "Popover, dropdown" },
    "xl": { "$value": [
              { "offsetX": "0px", "offsetY": "20px","blur": "25px", "spread": "-5px", "color": "rgb(0 0 0 / 0.10)" },
              { "offsetX": "0px", "offsetY": "8px", "blur": "10px", "spread": "-6px", "color": "rgb(0 0 0 / 0.06)" }
            ], "$description": "Dialog, modal" },
    "2xl":{ "$value": { "offsetX": "0px", "offsetY": "25px", "blur": "50px", "spread": "-12px", "color": "rgb(0 0 0 / 0.18)" }, "$description": "Hero overlay" },
    "inner": { "$value": { "offsetX": "0px", "offsetY": "2px", "blur": "4px", "spread": "0px", "color": "rgb(0 0 0 / 0.05) inset" }, "$description": "Pressed state" }
  },

  "z-index": {
    "$type": "number",
    "$description": "Layered scale. ShadCN base uses 10/20/30/40/50 — elxea adds named semantic layers on top.",
    "hide":     { "$value": "-1",   "$description": "Below content" },
    "base":     { "$value": "0",    "$description": "Default" },
    "raised":   { "$value": "10",   "$description": "Card, sticky" },
    "dropdown": { "$value": "1000", "$description": "Dropdown, select menu" },
    "sticky":   { "$value": "1020", "$description": "Sticky header" },
    "fixed":    { "$value": "1030", "$description": "Fixed banner" },
    "overlay":  { "$value": "1040", "$description": "Modal backdrop" },
    "modal":    { "$value": "1050", "$description": "Dialog, sheet" },
    "popover":  { "$value": "1060", "$description": "Popover, tooltip" },
    "toast":    { "$value": "1070", "$description": "Notification" },
    "max":      { "$value": "9999", "$description": "Emergency top" }
  },

  "breakpoint": {
    "$type": "dimension",
    "$description": "Responsive breakpoints. Matches Tailwind / ShadCN defaults — no elxea-specific BP. Mobile-first.",
    "sm":  { "$value": "40rem",  "$description": "640px — small tablet" },
    "md":  { "$value": "48rem",  "$description": "768px — tablet" },
    "lg":  { "$value": "64rem",  "$description": "1024px — desktop" },
    "xl":  { "$value": "80rem",  "$description": "1280px — wide desktop" },
    "2xl": { "$value": "96rem",  "$description": "1536px — full HD" }
  }
}
