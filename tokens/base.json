    "10": { "$value": "1rem", "$type": "dimension" },
    "15": { "$value": "1.5rem", "$type": "dimension" },
    "20": { "$value": "2rem", "$type": "dimension" },
    "40": { "$value": "4rem", "$type": "dimension" },
    "60": { "$value": "6rem", "$type": "dimension" },
    "80": { "$value": "8rem", "$type": "dimension" }
  },
  "shape": {
    "$description": "Border radius tokens",
    "radius-round": { "$value": "0.25rem", "$type": "dimension" },
    "radius-pill": { "$value": "1rem", "$type": "dimension" },
    "radius-circle": { "$value": "99rem", "$type": "dimension" }
  },
  "layout": {
    "$description": "Layout constraint tokens",
    "max-width": { "$value": "1280px", "$type": "dimension" },
    "max-width-container": { "$value": "1200px", "$type": "dimension" },
    "max-width-post": { "$value": "720px", "$type": "dimension" },
    "height-header": { "$value": "6rem", "$type": "dimension" }
