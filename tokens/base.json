      "regular": { "$value": 1.5, "$type": "number" },
      "wide": { "$value": 1.75, "$type": "number" }
    },
    "letterSpacing": {
      "narrow": { "$value": "0.025rem", "$type": "dimension" },
      "regular": { "$value": "0.05rem", "$type": "dimension" },
      "wide": { "$value": "0.125rem", "$type": "dimension" }
    }
  },
  "spacing": {
    "$description": "Webflow spacing scale",
    "0": { "$value": "0rem", "$type": "dimension" },
    "2-5": { "$value": "0.25rem", "$type": "dimension" },
