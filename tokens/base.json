      "primary": { "$value": "{color.brand.gray-120}", "$type": "color" },
      "primary-foreground": { "$value": "{color.brand.white}", "$type": "color" },
      "secondary": { "$value": "{color.brand.gold}", "$type": "color" },
      "secondary-foreground": { "$value": "{color.brand.gray-120}", "$type": "color" },
      "muted": { "$value": "{color.brand.gray-20}", "$type": "color" },
      "muted-foreground": { "$value": "{color.brand.gray-80}", "$type": "color" },
      "accent": { "$value": "{color.brand.gold}", "$type": "color" },
      "accent-foreground": { "$value": "{color.brand.gray-120}", "$type": "color" },
      "destructive": { "$value": "{color.brand.tea-red}", "$type": "color" },
      "destructive-foreground": { "$value": "{color.brand.white}", "$type": "color" },
      "border": { "$value": "{color.brand.gray-80}", "$type": "color" },
      "input": { "$value": "{color.brand.gray-20}", "$type": "color" },
      "ring": { "$value": "{color.brand.gray-80}", "$type": "color" },
      "success": { "$value": "{color.brand.tea-green}", "$type": "color" },
      "success-foreground": { "$value": "{color.brand.gray-120}", "$type": "color" },
      "warning": { "$value": "{color.brand.gold}", "$type": "color" },
      "warning-foreground": { "$value": "{color.brand.gray-120}", "$type": "color" },
      "info": { "$value": "#5b8fb9", "$type": "color" },
      "info-foreground": { "$value": "{color.brand.white}", "$type": "color" }
    }
  },
  "typography": {
    "$description": "elxea typography tokens (Webflow extracted values)",
    "family": {
      "sans": { "$value": "aktiv-grotesk, kozuka-gothic-pro, sans-serif", "$type": "fontFamily" },
      "heading": { "$value": "aktiv-grotesk-extended, dnp-shuei-gothic-gin-std, sans-serif", "$type": "fontFamily" },
      "secondary": { "$value": "neue-haas-grotesk-text, ryo-gothic-plusn, sans-serif", "$type": "fontFamily" },
      "special": { "$value": "dnp-shuei-ymincho-std, Georgia, serif", "$type": "fontFamily" },
      "mono": { "$value": "'SF Mono', Menlo, monospace", "$type": "fontFamily" }
    },
    "size": {
      "h1": { "$value": "3.25rem", "$type": "dimension" },
      "h2": { "$value": "2rem", "$type": "dimension" },
      "h2-alt": { "$value": "1.75rem", "$type": "dimension" },
      "h3": { "$value": "1.5rem", "$type": "dimension" },
      "h4": { "$value": "1.25rem", "$type": "dimension" },
      "h5": { "$value": "1rem", "$type": "dimension" },
      "h6": { "$value": "0.875rem", "$type": "dimension" },
