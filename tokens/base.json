{
  "color": {
    "$description": "elxea brand and semantic colors (Webflow extracted values)",
    "brand": {
      "gray-20": { "$value": "#ebe9e0", "$type": "color" },
      "gray-40": { "$value": "#d5d3c0", "$type": "color" },
      "gray-60": { "$value": "#adaca0", "$type": "color" },
      "gray-80": { "$value": "#858581", "$type": "color" },
      "gray-100": { "$value": "#5d5e61", "$type": "color" },
      "gray-120": { "$value": "#464748", "$type": "color" },
      "white": { "$value": "#ffffff", "$type": "color" },
      "black": { "$value": "#000000", "$type": "color" },
      "gold": { "$value": "#ffc200", "$type": "color" },
      "tea-green": { "$value": "#9ecbc0", "$type": "color" },
      "tea-red": { "$value": "#b9525c", "$type": "color" },
      "tea-warm": { "$value": "#e8b8a6", "$type": "color" }
    },
    "semantic": {
      "background": { "$value": "{color.brand.gray-40}", "$type": "color" },
      "foreground": { "$value": "{color.brand.gray-100}", "$type": "color" },
      "card": { "$value": "{color.brand.gray-40}", "$type": "color" },
      "card-foreground": { "$value": "{color.brand.gray-100}", "$type": "color" },
      "popover": { "$value": "{color.brand.gray-20}", "$type": "color" },
