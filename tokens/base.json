{
  "font": {
    "$type": "fontFamily",
    "sans": {
      "$value": "neue-haas-grotesk-text, kozuka-gothic-pro, sans-serif",
      "$description": "Body text"
    },
    "heading": {
      "$value": "termina, ryo-gothic-plusn, sans-serif",
      "$description": "Headings"
    }
  },
  "color": {
    "$type": "color",
    "background": { "$value": "oklch(1 0 0)" },
    "foreground": { "$value": "oklch(0.145 0 0)" },
    "card": { "$value": "oklch(1 0 0)" },
    "card-foreground": { "$value": "oklch(0.145 0 0)" },
    "popover": { "$value": "oklch(1 0 0)" },
    "popover-foreground": { "$value": "oklch(0.145 0 0)" },
    "primary": { "$value": "oklch(0.205 0 0)" },
    "primary-foreground": { "$value": "oklch(0.985 0 0)" },
    "secondary": { "$value": "oklch(0.97 0 0)" },
    "secondary-foreground": { "$value": "oklch(0.205 0 0)" },
    "muted": { "$value": "oklch(0.97 0 0)" },
    "muted-foreground": { "$value": "oklch(0.556 0 0)" },
    "accent": { "$value": "oklch(0.97 0 0)" },
    "accent-foreground": { "$value": "oklch(0.205 0 0)" },
    "destructive": { "$value": "oklch(0.577 0.245 27.325)" },
    "destructive-foreground": { "$value": "oklch(0.985 0 0)" },
    "border": { "$value": "oklch(0.922 0 0)" },
    "input": { "$value": "oklch(0.922 0 0)" },
    "ring": { "$value": "oklch(0.708 0 0)" }
  },
  "radius": {
    "$type": "dimension",
    "sm": { "$value": "0.25rem" },
    "md": { "$value": "0.375rem" },
    "lg": { "$value": "0.5rem" },
    "xl": { "$value": "0.75rem" }
  },
  "fontSize": {
    "$type": "dimension",
    "xs": { "$value": "0.75rem" },
    "sm": { "$value": "0.875rem" },
    "base": { "$value": "1rem" },
    "lg": { "$value": "1.125rem" },
    "xl": { "$value": "1.25rem" },
    "2xl": { "$value": "1.5rem" },
    "3xl": { "$value": "1.875rem" },
    "4xl": { "$value": "2.25rem" },
    "5xl": { "$value": "3rem" },
    "6xl": { "$value": "3.75rem" },
    "7xl": { "$value": "4.5rem" },
    "8xl": { "$value": "6rem" },
    "9xl": { "$value": "8rem" }
  },
  "fontWeight": {
    "$type": "fontWeight",
    "thin": { "$value": "100" },
    "extralight": { "$value": "200" },
    "light": { "$value": "300" },
    "normal": { "$value": "400" },
    "medium": { "$value": "500" },
    "semibold": { "$value": "600" },
    "bold": { "$value": "700" },
    "extrabold": { "$value": "800" },
    "black": { "$value": "900" }
  },
  "letterSpacing": {
    "$type": "dimension",
    "tighter": { "$value": "-0.05em" },
    "tight": { "$value": "-0.025em" },
    "normal": { "$value": "0em" },
    "wide": { "$value": "0.025em" },
    "wider": { "$value": "0.05em" },
    "widest": { "$value": "0.1em" }
  },
  "lineHeight": {
    "$type": "number",
    "none": { "$value": "1" },
    "tight": { "$value": "1.25" },
    "snug": { "$value": "1.375" },
    "normal": { "$value": "1.5" },
    "relaxed": { "$value": "1.625" },
    "loose": { "$value": "2" }
  },
  "spacing": {
    "$type": "dimension",
    "0": { "$value": "0px" },
    "px": { "$value": "1px" },
    "0.5": { "$value": "0.125rem" },
    "1": { "$value": "0.25rem" },
    "1.5": { "$value": "0.375rem" },
    "2": { "$value": "0.5rem" },
    "2.5": { "$value": "0.625rem" },
    "3": { "$value": "0.75rem" },
    "3.5": { "$value": "0.875rem" },
    "4": { "$value": "1rem" },
    "5": { "$value": "1.25rem" },
    "6": { "$value": "1.5rem" },
    "7": { "$value": "1.75rem" },
    "8": { "$value": "2rem" },
    "9": { "$value": "2.25rem" },
    "10": { "$value": "2.5rem" },
    "11": { "$value": "2.75rem" },
    "12": { "$value": "3rem" },
    "14": { "$value": "3.5rem" },
    "16": { "$value": "4rem" },
    "20": { "$value": "5rem" },
    "24": { "$value": "6rem" },
    "28": { "$value": "7rem" },
    "32": { "$value": "8rem" },
    "36": { "$value": "9rem" },
    "40": { "$value": "10rem" },
    "44": { "$value": "11rem" },
    "48": { "$value": "12rem" },
    "52": { "$value": "13rem" },
    "56": { "$value": "14rem" },
    "60": { "$value": "15rem" },
    "64": { "$value": "16rem" },
    "72": { "$value": "18rem" },
    "80": { "$value": "20rem" },
    "96": { "$value": "24rem" }
  },
  "shadow": {
    "$type": "shadow",
    "sm": {
      "$value": { "offsetX": "0px", "offsetY": "1px", "blur": "3px", "spread": "0px", "color": "rgb(0 0 0 / 0.1)" }
    },
    "md": {
      "$value": [
        { "offsetX": "0px", "offsetY": "4px", "blur": "6px", "spread": "-1px", "color": "rgb(0 0 0 / 0.1)" },
        { "offsetX": "0px", "offsetY": "2px", "blur": "4px", "spread": "-2px", "color": "rgb(0 0 0 / 0.1)" }
      ]
    },
    "lg": {
      "$value": [
        { "offsetX": "0px", "offsetY": "10px", "blur": "15px", "spread": "-3px", "color": "rgb(0 0 0 / 0.1)" },
        { "offsetX": "0px", "offsetY": "4px", "blur": "6px", "spread": "-4px", "color": "rgb(0 0 0 / 0.1)" }
      ]
    },
    "xl": {
      "$value": [
        { "offsetX": "0px", "offsetY": "20px", "blur": "25px", "spread": "-5px", "color": "rgb(0 0 0 / 0.1)" },
        { "offsetX": "0px", "offsetY": "8px", "blur": "10px", "spread": "-6px", "color": "rgb(0 0 0 / 0.1)" }
      ]
    },
    "2xl": {
      "$value": { "offsetX": "0px", "offsetY": "25px", "blur": "50px", "spread": "-12px", "color": "rgb(0 0 0 / 0.25)" }
    }
  },
  "breakpoint": {
    "$type": "dimension",
    "sm": { "$value": "40rem", "$description": "640px" },
    "md": { "$value": "48rem", "$description": "768px" },
    "lg": { "$value": "64rem", "$description": "1024px" },
    "xl": { "$value": "80rem", "$description": "1280px" },
    "2xl": { "$value": "96rem", "$description": "1536px" }
  },
  "borderWidth": {
    "$type": "dimension",
    "0": { "$value": "0px" },
    "1": { "$value": "1px" },
    "2": { "$value": "2px" },
    "4": { "$value": "4px" },
    "8": { "$value": "8px" }
  },
  "opacity": {
    "$type": "number",
    "0": { "$value": "0" },
    "5": { "$value": "0.05" },
    "10": { "$value": "0.1" },
    "20": { "$value": "0.2" },
    "25": { "$value": "0.25" },
    "30": { "$value": "0.3" },
    "40": { "$value": "0.4" },
    "50": { "$value": "0.5" },
    "60": { "$value": "0.6" },
    "70": { "$value": "0.7" },
    "75": { "$value": "0.75" },
    "80": { "$value": "0.8" },
    "90": { "$value": "0.9" },
    "95": { "$value": "0.95" },
    "100": { "$value": "1" }
  },
  "zIndex": {
    "$type": "number",
    "0": { "$value": "0" },
    "10": { "$value": "10" },
    "20": { "$value": "20" },
    "30": { "$value": "30" },
    "40": { "$value": "40" },
    "50": { "$value": "50" }
  }
}
