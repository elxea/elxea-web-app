          "fontWeight": "600",
          "lineHeight": "1.7",
          "letterSpacing": "0.04em"
        },
        "$description": "Small heading — CJK override"
      },
      "h6": {
        "$value": {
          "fontFamily": "termina, ryo-gothic-plusn, sans-serif",
