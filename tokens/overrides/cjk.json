          "letterSpacing": "0.04em"
        },
        "$description": "Large body text — CJK override"
      },
      "body": {
        "$value": {
          "fontFamily": "neue-haas-grotesk-text, kozuka-gothic-pro, sans-serif",
          "fontSize": "1rem",
          "fontWeight": "400",
          "lineHeight": "1.8",
          "letterSpacing": "0.04em"
        },
        "$description": "Default body text — CJK override"
      },
      "body-sm": {
        "$value": {
          "fontFamily": "neue-haas-grotesk-text, kozuka-gothic-pro, sans-serif",
