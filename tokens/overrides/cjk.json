      "code": {
        "$value": {
          "fontFamily": "SF Mono, Menlo, monospace",
          "fontSize": "0.875rem",
          "fontWeight": "400",
          "lineHeight": "1.8",
          "letterSpacing": "0em"
        },
        "$description": "Code / monospace text — CJK override"
