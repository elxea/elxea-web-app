{
  "$description": "CJK (Japanese) typography overrides — applied via :lang(ja). Overrides lineHeight and letterSpacing from base.json typography.style composites for improved Japanese text readability.",
  "typography": {
    "style": {
      "$type": "typography",
      "display": {
        "$value": {
          "fontFamily": "termina, ryo-gothic-plusn, sans-serif",
          "fontSize": "4.5rem",
          "fontWeight": "700",
          "lineHeight": "1.3",
          "letterSpacing": "0.02em"
        },
        "$description": "Hero / display text — CJK override"
      },
      "h1": {
        "$value": {
          "fontFamily": "termina, ryo-gothic-plusn, sans-serif",
          "fontSize": "3rem",
          "fontWeight": "700",
          "lineHeight": "1.4",
          "letterSpacing": "0.02em"
        },
        "$description": "Page title — CJK override"
      },
      "h2": {
        "$value": {
          "fontFamily": "termina, ryo-gothic-plusn, sans-serif",
          "fontSize": "2.25rem",
          "fontWeight": "600",
          "lineHeight": "1.5",
          "letterSpacing": "0.02em"
        },
        "$description": "Section heading — CJK override"
      },
      "h3": {
        "$value": {
          "fontFamily": "termina, ryo-gothic-plusn, sans-serif",
